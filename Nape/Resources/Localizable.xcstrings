            "value": "Gününüzü görün"
          }
        }
      }
    },
    "How long you leaned today, and the average weight your neck carried while you did.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ne kadar eğik kaldığınız ve o sırada boynunuzun taşıdığı ortalama ağırlık."
          }
        }
      }
    },
    "Next, Nape asks to send notifications so nudges reach your Apple Watch while your iPhone is locked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırada bildirim izni var: iPhone kilitliyken uyarıların Apple Watch'unuza ulaşması için."
          }
        }
      }
    },
