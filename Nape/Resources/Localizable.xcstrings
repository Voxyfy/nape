    "Sit up straight and look ahead": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dik oturun ve karşıya bakın"
          }
        }
      }
    },
    "Hold your head in a comfortable neutral position, then tap the button. Nape measures every tilt from here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başınızı rahat ve nötr bir konumda tutun, sonra düğmeye dokunun. Nape her eğimi buradan ölçer."
          }
        }
      }
    },
    "Put on your AirPods first": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce AirPods'unuzu takın"
          }
        }
      }
    },
    "Set as upright": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dik olarak ayarla"
          }
        }
