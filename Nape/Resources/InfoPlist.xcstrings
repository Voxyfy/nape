    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nape reads head orientation from your AirPods to measure how far your neck is tilted forward. Nothing leaves your device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nape, boynunuzun ne kadar öne eğildiğini ölçmek için AirPods'unuzdan baş yönelimini okur. Hiçbir veri cihazınızdan çıkmaz."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
